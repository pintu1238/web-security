{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NitiShield",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/Backend/app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PORT": "8501",
                "NITISHIELD_HOST": "0.0.0.0"
            },
            "serverReadyAction": {
                "pattern": "Running on http://\\S+",
                "uriFormat": "http://localhost:8501/#dashboard",
                "action": "openExternally"
            }
        }
    ]
}
